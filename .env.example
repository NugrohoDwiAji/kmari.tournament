# ============================================================
# Salin file ini ke .env.local dan isi semua nilainya
# cp .env.example .env.local
# ============================================================

# Auth.js secret — generate dengan:
# node -e "require('crypto').randomBytes(32).toString('base64url')"
AUTH_SECRET=""

# Kredensial Admin Panel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti_dengan_password_kuat"

# Koneksi database MySQL / MariaDB
DATABASE_URL="mysql://user:password@localhost:3306/tournament"
